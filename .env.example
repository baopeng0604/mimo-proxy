MIMO_API_KEY=sk-xxxxxxxx
MIMO_API_BASE=https://api.xiaomimimo.com/v1

# 是否启用 .env 密钥注入（默认关闭=纯透传）：
# 关闭：客户端请求头的 Bearer 原样透传给小米 API。
# 开启(true)：客户端没带 Authorization 时，自动用上面的 MIMO_API_KEY 注入。
#   - 客户端带了 → 仍用客户端的；客户端没带 → 用本 key 兜底。
#   - 适合个人/内网让客户端随便填 key 的场景。
# KEY_INJECTION=true

# 远程网页控制台访问口令（/console）。留空则不启用口令保护，仅建议本机调试。
CONSOLE_TOKEN=12345678
# 实时日志环形缓冲保留条数（默认 1000）
# CONSOLE_RING_MAX=1000